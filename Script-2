// KHYBER PAKHTUNKHWA LAKE DYNAMICS - 2025
// Landsat 8/9 → MNDWI → LOCAL OTSU PER LAKE
// → Reference Polygon → Lake Water Detection
// ============================================================


// ============================================================
// 1. SETTINGS
// ============================================================

var analysisStart = ee.Date('2025-06-01');
var analysisEnd   = ee.Date('2025-12-01');

// IMPORTANT:
// Use the exact spelling present in your PROVINCE field.
var provinceName = 'KHYBER PAKHTUNKHWA';


// ------------------------------------------------------------
// Local Otsu neighbourhood
// ------------------------------------------------------------

var otsuBufferMeters = 1000;


// ------------------------------------------------------------
// Maximum allowed lake expansion
// ------------------------------------------------------------

var lakeBufferMeters = 150;


// ------------------------------------------------------------
// Minimum overlap with reference polygon
// 0.09 ha ≈ one Landsat 30 m pixel
// ------------------------------------------------------------

var minOverlapHa = 0.09;


// ============================================================
// 2. SELECT KPK LAKES
// ============================================================

// IWMI point inventory
var provincePoints = pakistanLakes
  .filter(
    ee.Filter.eq(
